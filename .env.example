# Telegram bot (@BotFather dan oling)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Faqat siz ishlatishingiz uchun (Telegram user ID)
# @userinfobot dan ID oling
TELEGRAM_OWNER_ID=your_telegram_user_id

# Webhook xavfsizligi (Render Blueprint avtomatik yaratadi)
TELEGRAM_WEBHOOK_SECRET=random_secret_string

# Lokal: SQLite joyi (Renderda avtomatik /var/data/biznes.db)
# DATABASE_PATH=./data/biznes.db

# Render avtomatik beradi (lokalda ixtiyoriy)
# RENDER_EXTERNAL_URL=https://mybiznes-console.onrender.com
