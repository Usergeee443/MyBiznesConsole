# Telegram bot (@BotFather dan oling)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Faqat siz ishlatishingiz uchun (Telegram user ID)
TELEGRAM_OWNER_ID=your_telegram_user_id

# Webhook xavfsizligi (ixtiyoriy)
TELEGRAM_WEBHOOK_SECRET=random_secret_string

# SQLite (ixtiyoriy — default: ./data/biznes.db)
# DATABASE_PATH=./data/biznes.db

# MySQL (ixtiyoriy, server DB ga o'tish uchun)
# MYSQL_HOST=146.103.126.207
# MYSQL_PORT=3306
# MYSQL_USER=phpmyadmin
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=mybiznesconsole
# MYSQL_SSL=false
